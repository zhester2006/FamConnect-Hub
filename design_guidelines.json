  "instructions_to_main_agent": {
    "general": "You are building a 'Cosmic Family Hub'. It must feel like a high-end game UI, not a spreadsheet. Use the 'Black and Blue' theme aggressively but keep it readable.",
    "critical_rules": [
      "DO NOT use gradients for text unless it is a massive headline.",
      "DO NOT use pure black (#000000). Use Slate-950 (#020617).",
      "ALWAYS use 'Outfit' font for headings.",
      "ALWAYS use 'Manrope' font for body.",
      "Ensure all interactive elements have 'data-testid'.",
      "Use 'sonner' for toasts.",
      "Use 'lucide-react' for icons."
    ],
    "layout_specifics": {
      "home_hub": "Use a Bento Grid layout. Large widgets for Calendar and Weather. Smaller widgets for Chores and Messages.",
      "child_space": "Gamify it. Progress bars must be thick and colorful. Use badges and icons heavily.",
      "parent_dashboard": "Dense but clean. Use tables for lists but style them with glassmorphism."
    }
  },
  "universal_guidelines": {
    "design_philosophy": "Fusion over Imitation. Emotion First. Content is King.",
    "anti_patterns": [
      "Purple/Teal for CTA (Use Electric Blue/Yellow instead)",
      "Inter font everywhere (Use Outfit/Manrope)",
      "Center-everything (Use asymmetry)",
      "Gradient overload (Use texture/noise)"
    ],
    "accessibility": "Ensure contrast ratios (APCA). Support reduced motion preferences."
  }
}